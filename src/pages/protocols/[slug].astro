---
import { getCollection, getEntry } from 'astro:content';
import ProtocolLayout from '../../layouts/ProtocolLayout.astro';
import {
  isPublishedProtocol,
  protocolCollectionSlug,
  UNPUBLISHED_PROTOCOL_REDIRECTS,
} from '../../lib/unpublished-protocols';

export async function getStaticPaths() {
  const protocols = (await getCollection('protocols')).filter(isPublishedProtocol);
  return protocols.map((protocol) => ({
    params: { slug: protocolCollectionSlug(protocol) },
    props: { protocol },
  }));
}

const unpublishedDest = Astro.params.slug
  ? UNPUBLISHED_PROTOCOL_REDIRECTS[Astro.params.slug]
  : undefined;
if (unpublishedDest) {
  return Astro.redirect(unpublishedDest, 301);
}

// Support both static and SSR modes
let protocol = Astro.props.protocol;
if (!protocol) {
  const { slug } = Astro.params;
  protocol = await getEntry('protocols', slug as string);
}

if (!protocol || !isPublishedProtocol(protocol)) {
  return Astro.redirect('/404');
}

const { Content } = await protocol.render();
---

<ProtocolLayout
  title={protocol.data.title}
  description={protocol.data.description}
  peptides={protocol.data.peptides}
  researchSummary={protocol.data.researchSummary}
  studies={protocol.data.studies}
  mechanism={protocol.data.mechanism}
  safetyNotes={protocol.data.safetyNotes}
  disclaimer={protocol.data.disclaimer}
  lastUpdated={protocol.data.lastUpdated}
>
  <Content />
</ProtocolLayout>
