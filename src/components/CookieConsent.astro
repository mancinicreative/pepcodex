---
/**
 * CookieConsent.astro
 *
 * Cookie preferences shown on first visit; analytics uses basic consent mode.
 * Users can accept all cookies, decline non-essential cookies, or manage preferences.
 *
 * Uses localStorage to remember user's consent choice.
 * Integrates with Google Analytics to respect user preferences.
 */
---

<!-- Cookie Consent Popup -->
<div
  id="cookie-consent"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-consent-title"
>
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-[rgba(31,26,18,0.45)] backdrop-blur-sm" aria-hidden="true"></div>

  <!-- Modal -->
  <div class="fixed inset-0 flex items-end sm:items-center justify-center p-4">
    <div class="relative w-full max-w-lg bg-[color:var(--paper)] border border-[color:var(--border-c)] rounded-2xl overflow-hidden" style="box-shadow: var(--shadow-raise);">
      <!-- Cobalt accent rule -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-[color:var(--primary-c)]"></div>

      <div class="p-6">
        <!-- Header -->
        <div class="flex items-start gap-4 mb-4">
          <div class="flex-shrink-0 p-2 bg-[var(--primary-soft)] rounded-xl">
            <svg
              class="w-6 h-6 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
              <path d="M8.5 8.5v.01"/>
              <path d="M16 15.5v.01"/>
              <path d="M12 12v.01"/>
              <path d="M11 17v.01"/>
              <path d="M7 14v.01"/>
            </svg>
          </div>
          <div>
            <h2 id="cookie-consent-title" class="font-serif text-xl font-medium text-[color:var(--ink)]">
              Cookie Preferences
            </h2>
            <p class="text-sm text-[color:var(--ink-muted)] mt-1">
              We respect your privacy
            </p>
          </div>
        </div>

        <!-- Description -->
        <div class="mb-6 text-sm text-[color:var(--ink-muted)] leading-relaxed">
          <p>
            We use cookies to enhance your browsing experience and analyze site traffic.
            You can choose to accept all cookies or only essential ones.
          </p>
          <a
            href="/cookie-policy"
            class="inline-flex items-center gap-1 text-primary hover:text-[color:var(--primary-deep)] transition-colors mt-2"
          >
            Learn more about our cookies
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Cookie Categories (Expandable) -->
        <div id="cookie-details" class="hidden mb-6 space-y-3">
          <!-- Essential Cookies -->
          <div class="p-4 bg-[color:var(--paper-2)] rounded-xl border border-[color:var(--border-c)]">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-[color:var(--research)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                <div>
                  <h3 class="text-sm font-semibold text-[color:var(--ink)]">Essential</h3>
                  <p class="text-xs text-[color:var(--ink-muted)]">Required for website to function</p>
                </div>
              </div>
              <span class="text-xs text-[color:var(--research)] font-medium">Always On</span>
            </div>
          </div>

          <!-- Analytics Cookies -->
          <div class="p-4 bg-[color:var(--paper-2)] rounded-xl border border-[color:var(--border-c)]">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-[color:var(--primary-c)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18"/>
                  <path d="m19 9-5 5-4-4-3 3"/>
                </svg>
                <div>
                  <h3 class="text-sm font-semibold text-[color:var(--ink)]">Analytics</h3>
                  <p class="text-xs text-[color:var(--ink-muted)]">Help us improve our website</p>
                </div>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  id="analytics-toggle"
                  class="sr-only peer"
                  aria-label="Allow analytics cookies"
                />
                <div class="w-11 h-6 bg-[color:var(--sand)] peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-[var(--primary-c)] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-[color:var(--ink-paper)] after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-[color:var(--ink-paper)] after:border after:border-[color:var(--border-strong)] peer-checked:after:border-[color:var(--ink-paper)] after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--primary-c)]"></div>
              </label>
            </div>
          </div>
        </div>

        <button id="save-cookie-preferences" type="button" class="hidden w-full mb-3 text-sm text-primary">Save preferences</button>

        <!-- Show/Hide Details Toggle -->
        <button
          id="toggle-cookie-details"
          type="button"
          class="w-full mb-6 py-2 text-sm text-[color:var(--ink-muted)] hover:text-[color:var(--ink)] transition-colors flex items-center justify-center gap-2"
        >
          <span id="details-toggle-text">Show cookie details</span>
          <svg id="details-toggle-icon" class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3">
          <button
            id="decline-cookies"
            type="button"
            class="flex-1 px-4 py-3 text-sm font-medium text-[color:var(--ink-muted)] hover:text-[color:var(--ink)] border border-[color:var(--border-c)] hover:border-[color:var(--border-strong)] rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--primary-c)]"
          >
            Essential Only
          </button>
          <button
            id="accept-cookies"
            type="button"
            class="flex-1 px-4 py-3 text-sm font-medium text-[color:var(--ink-paper)] bg-[color:var(--primary-c)] hover:bg-[color:var(--primary-deep)] rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--primary-c)] focus:ring-offset-2 focus:ring-offset-[color:var(--paper)]"
          >
            Accept All
          </button>
        </div>

        <!-- Privacy Links -->
        <div class="mt-4 pt-4 border-t border-[color:var(--border-c)] flex flex-wrap justify-center gap-4 text-xs text-[color:var(--ink-dim)]">
          <a href="/privacy" class="hover:text-[color:var(--ink)] transition-colors">Privacy Policy</a>
          <span>|</span>
          <a href="/terms" class="hover:text-[color:var(--ink)] transition-colors">Terms of Service</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  interface CookieConsent {
    essential: boolean;
    analytics: boolean;
    timestamp: number;
  }

  const STORAGE_KEY = 'pepcodex_cookie_consent';
  let previousFocus: HTMLElement | null = null;
  let previousOverflow = '';

  function getStoredConsent(): CookieConsent | null {
    return window.pepcodexAnalytics?.readConsent() || null;
  }

  function setConsent(consent: CookieConsent): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
    } catch (e) {
      // localStorage not available
    }
  }

  function applyConsent(consent: CookieConsent): void {
    window.pepcodexAnalytics?.setConsent(consent.analytics);
  }

  function showConsentPopup(): void {
    const popup = document.getElementById('cookie-consent');
    if (popup) {
      if (!popup.classList.contains('hidden')) return;
      previousFocus = document.activeElement as HTMLElement | null;
      previousOverflow = document.body.style.overflow;
      const analyticsToggle = document.getElementById('analytics-toggle') as HTMLInputElement | null;
      if (analyticsToggle) analyticsToggle.checked = getStoredConsent()?.analytics === true;
      popup.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // Move focus into the dialog; the key handler keeps it inside while open.
      const firstFocusable = popup.querySelector('button, [href], input') as HTMLElement;
      if (firstFocusable) {
        firstFocusable.focus();
      }
    }
  }

  function hideConsentPopup(): void {
    const popup = document.getElementById('cookie-consent');
    if (popup) {
      popup.classList.add('hidden');
      document.body.style.overflow = previousOverflow;
      previousFocus?.focus();
    }
  }

  function initCookieConsent(): void {
    const existingConsent = getStoredConsent();

    if (existingConsent) applyConsent(existingConsent);
    else showConsentPopup();

    // Get UI elements
    const acceptBtn = document.getElementById('accept-cookies');
    const declineBtn = document.getElementById('decline-cookies');
    const toggleBtn = document.getElementById('toggle-cookie-details');
    const detailsSection = document.getElementById('cookie-details');
    const toggleText = document.getElementById('details-toggle-text');
    const toggleIcon = document.getElementById('details-toggle-icon');
    const analyticsToggle = document.getElementById('analytics-toggle') as HTMLInputElement;
    const saveBtn = document.getElementById('save-cookie-preferences');
    if (analyticsToggle) analyticsToggle.checked = existingConsent?.analytics === true;
    document.querySelectorAll('[data-cookie-preferences]').forEach(button => {
      button.addEventListener('click', showConsentPopup);
    });
    saveBtn?.addEventListener('click', () => {
      const consent = { essential: true, analytics: analyticsToggle?.checked === true, timestamp: Date.now() };
      setConsent(consent);
      applyConsent(consent);
      hideConsentPopup();
    });

    // Toggle details visibility
    if (toggleBtn && detailsSection && toggleText && toggleIcon) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = detailsSection.classList.contains('hidden');
        detailsSection.classList.toggle('hidden');
        saveBtn?.classList.toggle('hidden', !isHidden);
        toggleText.textContent = isHidden ? 'Hide cookie details' : 'Show cookie details';
        toggleIcon.style.transform = isHidden ? 'rotate(180deg)' : '';
      });
    }

    // Accept all cookies
    if (acceptBtn) {
      acceptBtn.addEventListener('click', () => {
        const consent: CookieConsent = {
          essential: true,
          analytics: true,
          timestamp: Date.now()
        };
        setConsent(consent);
        applyConsent(consent);
        hideConsentPopup();
      });
    }

    // Decline non-essential (save preferences from toggles)
    if (declineBtn) {
      declineBtn.addEventListener('click', () => {
        const consent: CookieConsent = {
          essential: true,
          analytics: false, // Essential only means no analytics
          timestamp: Date.now()
        };
        setConsent(consent);
        applyConsent(consent);
        hideConsentPopup();
      });
    }

    // Escape leaves the current consent unchanged; the footer can reopen preferences.
    document.addEventListener('keydown', (e) => {
      const popup = document.getElementById('cookie-consent');
      if (!popup || popup.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        hideConsentPopup();
      } else if (e.key === 'Tab') {
        const controls = Array.from(popup.querySelectorAll<HTMLElement>('button, [href], input'))
          .filter(el => !el.closest('.hidden') && !el.hasAttribute('disabled'));
        const first = controls[0], last = controls[controls.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
      }
    });
  }

  // Extend window for gtag
  declare global {
    interface Window {
      gtag: (...args: any[]) => void;
      dataLayer: any[];
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieConsent);
  } else {
    initCookieConsent();
  }

  // Also handle View Transitions (Astro)
  document.addEventListener('astro:page-load', () => {
    // Only check consent on page load, don't show popup again
    const existingConsent = getStoredConsent();
    if (existingConsent) {
      applyConsent(existingConsent);
    }
  });
</script>
