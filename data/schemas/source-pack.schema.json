{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://peptidelibrary.com/schemas/source-pack.schema.json",
  "title": "Source Pack",
  "description": "Source-pack shape contract. Schema validity is not verification of source identity, authority, current status, or claim support.",
  "type": "object",
  "required": [
    "peptide",
    "sources",
    "metadata"
  ],
  "properties": {
    "peptide": {
      "type": "object",
      "required": [
        "name",
        "category"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Primary name of the peptide"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Alternative names, brand names, research codes"
        },
        "category": {
          "type": "string",
          "enum": [
            "metabolic",
            "repair-recovery",
            "hormonal",
            "cognitive",
            "other"
          ],
          "description": "Primary category for the peptide"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/researchSource"
          },
          {
            "$ref": "#/definitions/regulatorySource"
          },
          {
            "$ref": "#/definitions/referenceSource"
          }
        ]
      }
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nctId",
          "title",
          "status"
        ],
        "properties": {
          "nctId": {
            "type": "string",
            "pattern": "^NCT\\d{8}$",
            "description": "ClinicalTrials.gov identifier"
          },
          "title": {
            "type": "string",
            "description": "Official trial title"
          },
          "status": {
            "type": "string",
            "enum": [
              "recruiting",
              "active",
              "completed",
              "terminated",
              "withdrawn",
              "not-yet-recruiting",
              "enrolling-by-invitation",
              "suspended",
              "unknown"
            ],
            "description": "Current recruitment/study status"
          },
          "phase": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "1/2",
              "2/3",
              "not-applicable"
            ],
            "description": "Clinical trial phase"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Medical conditions being studied"
          },
          "interventions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Interventions being tested"
          },
          "enrollmentTarget": {
            "type": "integer",
            "minimum": 1,
            "description": "Target enrollment number"
          },
          "startDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "pattern": "^(?!0000)[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?$"
              }
            ],
            "description": "Study start calendar date at its recorded precision: YYYY, YYYY-MM or valid YYYY-MM-DD. Never infer an unreported month or day."
          },
          "completionDate": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              {
                "type": "string",
                "pattern": "^(?!0000)[0-9]{4}(?:-(?:0[1-9]|1[0-2]))?$"
              }
            ],
            "description": "Estimated or actual completion calendar date at its recorded precision: YYYY, YYYY-MM, valid YYYY-MM-DD or null. Precision does not establish whether the date is estimated or actual."
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "generatedAt",
        "sourceCounts"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When this source pack was generated"
        },
        "sourceCounts": {
          "type": "object",
          "required": [
            "total",
            "human",
            "preclinical",
            "openAccess"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of sources"
            },
            "human": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of human studies"
            },
            "preclinical": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of animal/in-vitro studies"
            },
            "openAccess": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of open access sources"
            },
            "regulatory": {
              "type": "integer",
              "minimum": 0,
              "description": "Regulatory documents, not human studies."
            },
            "reference": {
              "type": "integer",
              "minimum": 0,
              "description": "Reference documents, not human studies."
            }
          }
        }
      }
    }
  },
  "definitions": {
    "researchSource": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "year"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(PMID:\\d+|DOI:.+|NCT\\d+)$",
          "description": "Unique identifier (PMID:xxx, DOI:xxx, or NCTxxx)"
        },
        "type": {
          "type": "string",
          "enum": [
            "pubmed",
            "europePMC",
            "clinicalTrials",
            "preprint"
          ],
          "description": "Source database type"
        },
        "title": {
          "type": "string",
          "description": "Title of the publication or study"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of author names"
        },
        "journal": {
          "type": "string",
          "description": "Journal name or preprint server"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100,
          "description": "Publication year"
        },
        "studyType": {
          "type": "string",
          "enum": [
            "RCT",
            "observational",
            "meta-analysis",
            "review",
            "case-series",
            "preclinical",
            "in-vitro"
          ],
          "description": "Type of study design"
        },
        "subjects": {
          "type": "string",
          "enum": [
            "human",
            "animal",
            "in-vitro"
          ],
          "description": "Type of subjects studied"
        },
        "sampleSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Number of subjects/samples"
        },
        "openAccess": {
          "type": "boolean",
          "description": "Whether the full text is freely available"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Full URL to the source"
        },
        "abstract": {
          "type": "string",
          "description": "Abstract or summary of the publication"
        }
      }
    },
    "unknownValue": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "knownOrUnknown": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/definitions/unknownValue"
        }
      ]
    },
    "regulatorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "authority",
        "jurisdiction",
        "officialUrl",
        "retrievedAt",
        "supportLocator",
        "documentId",
        "version",
        "documentType",
        "scopeNote",
        "product",
        "route",
        "indication"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REG:[^\\s]+$",
          "description": "Local stable document identifier, not a fabricated research database ID."
        },
        "type": {
          "const": "regulatory"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "officialUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Authority-hosted document URL. Host authenticity requires independent verification."
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "supportLocator": {
          "type": "string",
          "minLength": 1,
          "description": "Specific section, paragraph, page or table supporting the intended claim."
        },
        "documentId": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "version": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "publicationDate": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/definitions/unknownValue"
            }
          ]
        },
        "effectiveDate": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/definitions/unknownValue"
            }
          ]
        },
        "openAccess": {
          "type": "boolean"
        },
        "scopeNote": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "route": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "indication": {
          "$ref": "#/definitions/knownOrUnknown"
        }
      }
    },
    "referenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "authority",
        "jurisdiction",
        "officialUrl",
        "retrievedAt",
        "supportLocator",
        "documentId",
        "version",
        "documentType",
        "scopeNote"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REF:[^\\s]+$",
          "description": "Local stable document identifier, not a fabricated research database ID."
        },
        "type": {
          "const": "reference"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "officialUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Authority-hosted document URL. Host authenticity requires independent verification."
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "supportLocator": {
          "type": "string",
          "minLength": 1,
          "description": "Specific section, paragraph, page or table supporting the intended claim."
        },
        "documentId": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "version": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "publicationDate": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/definitions/unknownValue"
            }
          ]
        },
        "effectiveDate": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/definitions/unknownValue"
            }
          ]
        },
        "openAccess": {
          "type": "boolean"
        },
        "scopeNote": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "route": {
          "$ref": "#/definitions/knownOrUnknown"
        },
        "indication": {
          "$ref": "#/definitions/knownOrUnknown"
        }
      }
    }
  }
}
