  "devDependencies": {
    "@pagefind/default-ui": "^1.4.0",
    "@vercel/node": "^5.5.28",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.4.0"
