    "build": "astro build",
    "postbuild": "npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "validate-links": "node scripts/validate-cross-links.mjs",
    "qa-seo": "node scripts/qa-seo.mjs",
    "qa-scoring": "node scripts/qa-scoring.mjs",
    "qa-pmids": "node scripts/qa-pmids.mjs --strict",
    "qa-retractions": "node scripts/qa-retractions.mjs",
    "refresh-trials-all": "node scripts/refresh-trials-all.mjs",
    "qa:consistency": "node scripts/qa-internal-consistency.mjs --strict",
    "qa:trials": "node scripts/triage-trials.mjs",
    "qa:packcites": "node scripts/verify-pack-citations.mjs",
    "qa:dossiercites": "node scripts/verify-dossier-citations.mjs --strict",
    "qa:blogsources": "node scripts/verify-blog-sources.mjs",
    "research:scan": "node scripts/monthly-research-scan.mjs",
    "qa:claims": "node scripts/qa-claim-consistency.mjs",
    "qa:quant": "node scripts/verify-quantitative-claims.mjs",
