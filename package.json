{
  "name": "peptide-library",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/validate-cross-links.mjs && node scripts/qa-seo.mjs && node scripts/qa-scoring.mjs && node scripts/qa-pmids.mjs --strict && node scripts/qa-source-identifiers.mjs --strict",
    "prebuild": "npm run check",
    "build": "astro build",
    "postbuild": "npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "validate-links": "node scripts/validate-cross-links.mjs",
    "qa-seo": "node scripts/qa-seo.mjs",
    "qa-scoring": "node scripts/qa-scoring.mjs",
    "qa-pmids": "node scripts/qa-pmids.mjs --strict",
    "qa-retractions": "node scripts/qa-retractions.mjs",
    "gsc:sites": "node scripts/fetch-search-data.mjs --list-sites",
    "fetch:search": "node scripts/fetch-search-data.mjs",
    "fetch:gsc": "node scripts/fetch-search-data.mjs --gsc",
    "fetch:ga4": "node scripts/fetch-search-data.mjs --ga4",
    "gsc:whoami": "node scripts/fetch-search-data.mjs --whoami",
    "graph": "node scripts/crawl-graph.mjs",
    "graph:compare": "node scripts/crawl-graph.mjs --compare",
    "graph:check": "node scripts/crawl-graph.mjs --check",
    "gsc:index": "node scripts/gsc-index-diagnose.mjs",
    "gsc:repull": "node scripts/gsc-repull.mjs",
    "ga4:pull": "node scripts/ga4-pull.mjs",
    "qa-sources": "node scripts/qa-source-identifiers.mjs --strict"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^9.0.5",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^1.6.1",
    "astro": "^5.18.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@google-analytics/data": "^6.1.0",
    "@pagefind/default-ui": "^1.4.0",
    "@vercel/node": "^5.5.28",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "googleapis": "^173.0.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.4.0"
  }
}
