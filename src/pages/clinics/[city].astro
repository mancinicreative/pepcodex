---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/SEO/BreadcrumbSchema.astro';

export const prerender = true;

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { city: city.id.replace(/\.mdx?$/, '') },
    props: { city }
  }));
}

const { city } = Astro.props;
const { name, state, stateAbbr } = city.data;
const citySlug = city.id.replace(/\.mdx?$/, '');

// City pages are empty shells after W0-2. Do not collect or render clinic
// records — prior listings were placeholders.
const citySlugSet = new Set(
  (await getCollection('cities')).map((c) => c.id.replace(/\.mdx?$/, ''))
);

const allCities = await getCollection('cities');
const nearbyCities = allCities
  .filter((c) => c.data.state === state && c.id !== city.id)
  .map((c) => ({
    name: c.data.name,
    slug: c.id.replace(/\.mdx?$/, ''),
  }))
  .filter((c) => citySlugSet.has(c.slug))
  .slice(0, 6);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Peptide Clinics', url: '/clinics' },
  { name: `${name}, ${stateAbbr}`, url: `/clinics/${citySlug}` }
];
---

{/* Deindexed 2026-07: clinic URLs consume crawl budget the site cannot spare.
    Pages stay live for direct visitors and keep passing internal links
    (noindex, follow). Sitemap exclude lives in astro.config.mjs (/clinics/ rule).
    W0-2 2026-09-02: placeholder clinic records and city FAQ schema removed. */}
<BaseLayout
  title={`Peptide Clinics in ${name}, ${stateAbbr}`}
  description={`PepCodex does not currently list clinics in ${name}, ${stateAbbr}. Placeholder and unverified listings have been removed.`}
  robots="noindex"
>
  <BreadcrumbSchema items={breadcrumbs} />

  <section class="mb-12">
    <nav class="text-sm mb-6" style="color: var(--text-low);">
      <ol class="flex items-center gap-2 flex-wrap">
        {breadcrumbs.map((crumb, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span>/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span style="color: var(--text-medium);">{crumb.name}</span>
            ) : (
              <a href={crumb.url} class="hover:text-primary transition-colors">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <div class="max-w-4xl">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4 font-display" style="color: var(--text-high);">
        Peptide Clinics in <span class="gradient-text">{name}, {state}</span>
      </h1>
    </div>
  </section>

  <section class="mb-12">
    <div class="glass-card p-8 text-center">
      <svg class="w-16 h-16 mx-auto mb-4 text-primary opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      <h2 class="text-xl font-bold mb-3" style="color: var(--text-high);">
        No Clinics Listed in {name}
      </h2>
      <p class="mb-6" style="color: var(--text-medium);">
        We do not currently list clinics in {name}, {state}. Placeholder names,
        addresses, and phone numbers were removed. This page does not publish
        clinic contact details, prices, or peptide menus.
      </p>
      <a href="/contact" class="btn btn-primary btn-md">
        Contact PepCodex
      </a>
    </div>
  </section>

  {nearbyCities.length > 0 && (
    <section class="mb-12">
      <div class="section-header">
        <div class="section-header__bar"></div>
        <h2 class="section-header__title">Other {state} Cities</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {nearbyCities.map((nearbyCity) => (
          <a
            href={`/clinics/${nearbyCity.slug}`}
            class="glass-card glass-card--interactive p-4 text-center"
          >
            <h3 class="font-semibold text-sm" style="color: var(--text-high);">
              {nearbyCity.name}
            </h3>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
