# Beehiiv Newsletter Integration
# Get these from your Beehiiv dashboard: https://app.beehiiv.com/settings/integrations
BEEHIIV_API_KEY=your_api_key_here
BEEHIIV_PUBLICATION_ID=your_publication_id_here

# Google Analytics 4 (client-side tag, shipped to the browser)
# Get this from Google Analytics: Admin > Data Streams > Your Stream > Measurement ID
# Format: G-XXXXXXXXXX
PUBLIC_GA_TRACKING_ID=

# --- Search/analytics data pulls (local only, never shipped) ---
# Setup walkthrough: .planning/GOOGLE-API-SETUP.md

# Absolute path to the GCP service-account JSON key (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=

# Search Console properties, comma-separated. Discover with: npm run gsc:sites
# Domain properties look like  sc-domain:pepcodex.com
# URL-prefix properties look like  https://www.pepcodex.com/
GSC_SITE_URLS=

# GA4 numeric Property ID — Admin > Property Settings > Property ID.
# NOT the G-XXXXXXXX measurement id above.
GA4_PROPERTY_ID=
