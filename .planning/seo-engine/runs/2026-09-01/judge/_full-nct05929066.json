ructive sleep apnea (OSA) (J1I-MC-GSA1). This study will last about 89 weeks and will include up to 24 visits. Addendum (2) is optional and available to approximately 500 participants to continue treatment with retatrutide for up to an additional 24 weeks."},"conditionsModule":{"conditions":["Obesity","Overweight","Osteoarthritis, Knee","Obstructive Sleep Apnea"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"DOUBLE","whoMasked":["PARTICIPANT","INVESTIGATOR"]}},"enrollmentInfo":{"count":2335,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Retatrutide Dose 1","type":"EXPERIMENTAL","description":"Participants will receive retatrutide subcutaneously (SC).","interventionNames":["Drug: Retatrutide"]},{"label":"Retatrutide Dose 2","type":"EXPERIMENTAL","description":"Participants will receive retatrutide SC.","interventionNames":["Drug: Retatrutide"]},{"label":"Retatrutide Dose 3","type":"EXPERIMENTAL","description":"Participants will receive retatrutide SC.","interventionNames":["Drug: Retatrutide"]},{"label":"Placebo","type":"PLACEBO_COMPARATOR","description":"Participants will receive placebo.","interventionNames":["Drug: Placebo"]},{"label":"Retatrutide Extension Period","type":"EXPERIMENTAL","description":"Participants will receive retatrutide after the placebo-controlled 80 week treatment period for an additional 24 weeks.","interventionNames":["Drug: Retatrutide"]}],"interventions":[{"type":"DRUG","name":"Retatrutide","description":"Administered SC","armGroupLabels":["Retatrutide Dose 1","Retatrutide Dose 2","Retatrutide Dose 3","Retatrutide Extension Period"],"otherNames":["LY3437943"]},{"type":"DRUG","name":"Placebo","description":"Administered SC","armGroupLabels":["Placebo"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Percent Change From Baseline in Body Weight","timeFrame":"Baseline, Week 8