---
import BaseLayout from '../layouts/BaseLayout.astro';
---

{/* W0-5: holding page. Not a clinic finder. noindex + sitemap drop — noindex
    alone does not save crawl budget (astro.config.mjs SITEMAP_EXCLUDE). */}
<BaseLayout
  robots="noindex"
  title="Directory"
  description="PepCodex does not list clinics or providers. This page is a placeholder, not a clinic directory."
>
  <div class="relative">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="font-serif text-5xl md:text-6xl tracking-tight" style="color: var(--ink); font-weight: 500;">
          Directory
        </h1>
        <p class="mt-6 text-xl max-w-2xl mx-auto leading-relaxed" style="color: var(--ink-muted);">
          PepCodex does not list clinics or providers. This is not a clinic finder.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="glass-card relative overflow-hidden p-8">
          <div class="relative">
            <p class="leading-relaxed mb-6" style="color: var(--ink-muted);">
              There are no clinic listings on this site. Placeholder records were removed.
              City pages under Clinics are empty shells and are not an endorsement of any provider.
            </p>
            <p class="leading-relaxed mb-8" style="color: var(--ink-muted);">
              PepCodex is a research library. Use the peptide dossiers, trial tracker, and methodology pages.
            </p>
            <ul class="space-y-3">
              <li>
                <a href="/peptides" class="inline-flex items-center gap-2 btn btn-cobalt btn-md">
                  Peptide dossiers
                </a>
              </li>
              <li>
                <a href="/trials" class="transition-colors hover:text-[color:var(--primary-c)]" style="color: var(--ink-muted);">
                  Clinical trial tracker
                </a>
              </li>
              <li>
                <a href="/methodology" class="transition-colors hover:text-[color:var(--primary-c)]" style="color: var(--ink-muted);">
                  Methodology
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
