---
import MedicalWebPageSchema from './MedicalWebPageSchema.astro';

// Compatibility adapter for dossier callers: legacy substance-specific props
// remain accepted but do not become unverified claims about the page or product.

interface Props {
  name: string;
  alternateName?: string[];
  description: string;
  drugClass?: string;
  mechanismOfAction?: string;
  activeIngredient?: string;
  administrationRoute?: string;
  legalStatus?: string;
  manufacturer?: string;
  nonProprietaryName?: string;
  molecularWeight?: string;
  url: string;
}

const { name, alternateName, description, url } = Astro.props;
---

<MedicalWebPageSchema {name} {alternateName} {description} {url} />
