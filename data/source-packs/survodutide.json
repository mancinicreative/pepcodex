  "sources": [
    {
      "id": "PMID:37840093",
      "type": "pubmed",
      "title": "Survodutide for the treatment of obesity: a randomised, double-blind, placebo-controlled, dose-finding phase 2 trial",
      "authors": [
        "le Roux CW",
        "Steen O",
        "Lucas KJ",
        "et al."
      ],
      "journal": "Nature Medicine",
      "year": 2024,
      "studyType": "RCT",
      "subjects": "human",
      "sampleSize": 387,
      "openAccess": true,
      "url": "https://pubmed.ncbi.nlm.nih.gov/37840093/",
      "abstract": "Phase 2 dose-ranging trial in adults with obesity. Survodutide 4.8mg achieved 18.7% weight loss at 46 weeks vs 2.1% placebo. Dose-dependent weight reduction with GI adverse events consistent with class."
    },
    {
      "id": "PMID:38507727",
      "type": "pubmed",
      "title": "Survodutide for the Treatment of Participants with Metabolic Dysfunction-Associated Steatohepatitis (MASH): A Phase 2 Randomized Clinical Trial",
      "authors": [
        "Sanyal AJ",
        "Bedossa P",
        "Engwerda CR",
        "et al."
      ],
      "journal": "New England Journal of Medicine",
      "year": 2024,
      "studyType": "RCT",
      "subjects": "human",
      "sampleSize": 293,
      "openAccess": true,
      "url": "https://pubmed.ncbi.nlm.nih.gov/38507727/",
      "abstract": "Phase 2 trial in MASH with fibrosis (F1-F3). 83% achieved MASH resolution at 48 weeks with survodutide 6.0mg vs 18% placebo. Significant fibrosis improvement (64.5% vs 25.9%). Practice-changing MASH data."
    },
    {
      "id": "PMID:36702559",
      "type": "pubmed",
      "title": "Efficacy and safety of BI 456906, a dual GLP-1/glucagon receptor agonist, in type 2 diabetes: a randomized, double-blind, placebo and active-controlled, phase 2 trial",
      "authors": [
        "Nauck MA",
        "D'Alessio D",
        "Davies MJ",
        "et al."
      ],
      "journal": "Lancet Diabetes Endocrinology",
      "year": 2023,
      "studyType": "RCT",
      "subjects": "human",
      "sampleSize": 411,
      "openAccess": true,
      "url": "https://pubmed.ncbi.nlm.nih.gov/36702559/",
      "abstract": "Phase 2 in T2D. HbA1c reduction up to -1.9% vs placebo; weight loss up to -10% at 16 weeks. Superior to semaglutide 1mg for weight loss. First evidence of dual agonist efficacy in diabetes."
    },
    {
      "id": "PMID:35657668",
      "type": "pubmed",
      "title": "BI 456906: A Novel, Dual Glucagon/GLP-1 Receptor Agonist with Potent Preclinical Activity for the Treatment of Obesity and Diabetes",
