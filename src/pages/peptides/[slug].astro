---
import { getCollection, getEntry } from 'astro:content';
import DossierLayout from '../../layouts/DossierLayout.astro';

export async function getStaticPaths() {
  const peptides = await getCollection('peptides');
  return peptides.map((peptide) => ({
    params: { slug: peptide.slug },
    props: { peptide },
  }));
}

// Support both static and SSR modes
let peptide = Astro.props.peptide;
if (!peptide) {
  const { slug } = Astro.params;
  peptide = await getEntry('peptides', slug as string);
}

if (!peptide) {
  return Astro.redirect('/404');
}

const { Content } = await peptide.render();

const FDA_STATUS_LABEL: Record<string, string> = {
  approved: 'FDA Approved',
  investigational: 'Investigational',
  'compounding-restricted': 'Compounding Restricted',
  'research-only': 'Research Only',
};

function firstNoteSentence(text?: string): string | undefined {
  if (!text) return undefined;
  const compact = text.replace(/\s+/g, ' ').trim();
  const match = compact.match(/^.+?[.](?=\s|$)/);
  const sentence = (match ? match[0] : compact).trim();
  return sentence.length > 280 ? `${sentence.slice(0, 277)}…` : sentence;
}

const reg = peptide.data.regulatoryStatus;
const noteWarning = firstNoteSentence(reg?.notes);
const safetyInfo = {
  fdaStatus: reg?.status ? FDA_STATUS_LABEL[reg.status] : undefined,
  keyWarnings: noteWarning ? [noteWarning] : [],
};
---

<DossierLayout
  name={peptide.data.name}
  slug={peptide.slug}
  aliases={peptide.data.aliases}
  category={peptide.data.category}
  evidenceStrength={peptide.data.evidenceStrength}
  lastUpdated={peptide.data.lastUpdated}
  summary={peptide.data.summary}
  sources={peptide.data.sources}
  comparators={peptide.data.comparators}
  conditions={peptide.data.conditions}
  interactions={peptide.data.interactions}
  molecularInfo={peptide.data.molecularInfo}
  evidenceChainedBenefits={peptide.data.evidenceChainedBenefits}
  timeline={peptide.data.timeline}
  regulatoryStatus={peptide.data.regulatoryStatus}
  ratings={peptide.data.ratings}
  scoring={peptide.data.scoring}
  anecdotalReports={peptide.data.anecdotalReports}
  limitations={peptide.data.limitations}
  mechanismPathways={peptide.data.mechanismPathways}
  metaTitle={peptide.data.metaTitle}
  metaDescription={peptide.data.metaDescription}
  safetyInfo={safetyInfo}
>
  <Content />
</DossierLayout>
